class Botropolis < Formula
  desc "Every Claude Code session on this machine, drawn as a city"
  homepage "https://botropolis.city"
  url "@URL@"
  version "@VERSION@"
  sha256 "@SHA256@"
  license all_of: ["MIT", "OFL-1.1", "CC0-1.0", "BSD-3-Clause"]

  depends_on "go" => :build

  def install
    ENV["CGO_ENABLED"] = "0"
    ldflags = "-X botropolis.city/botropolis/pkg/version.Version=#{version}"
    %w[botropolis botropolisd botropolis-hook].each do |cmd|
      system "go", "build", *std_go_args(ldflags:, output: bin/cmd), "./cmd/#{cmd}"
    end
    generate_completions_from_executable(bin/"botropolis", "completion", shells: [:bash, :zsh, :fish])
    system "go", "run", "-ldflags", ldflags, "./tools/man", "-out", "man", "-date", Time.now.utc.strftime("%F")
    man1.install Dir["man/*.1.gz"]
    man5.install Dir["man/*.5.gz"]
    pkgshare.install "packaging/botropolis.bash"
    (share/"licenses/botropolis").install "pkg/assets/fonts/inter/LICENSE.txt" => "inter-OFL.txt",
                                          "pkg/assets/fonts/gomono/LICENSE" => "gomono-BSD.txt",
                                          "pkg/assets/kits/nature-kit/License.txt" => "kenney-CC0.txt",
                                          "pkg/assets/kits/README.md" => "kenney-kits.md",
                                          "pkg/assets/kenney/README.md" => "kenney-packs.md"
  end

  def caveats
    <<~EOS
      Finish with one command, which starts the daemon (brew services), registers
      the hooks, and prints the line for your shell's startup file:
        botropolis setup

      That line makes a plain `claude` a background session the city can see:
        zsh   ~/.zshrc                    eval "$(botropolis shell-init zsh)"
        bash  ~/.bashrc                   eval "$(botropolis shell-init bash)"
        fish  ~/.config/fish/config.fish  botropolis shell-init fish | source

      Completion for zsh and fish works as installed; for bash it needs
      Homebrew's bash-completion.

      Sharing the city (shift+s in it) saves pictures and GIFs as it is;
      a video clip needs ffmpeg:
        brew install ffmpeg
    EOS
  end

  service do
    run opt_bin/"botropolisd"
    keep_alive true
    environment_variables PATH: std_service_path_env
    log_path var/"log/botropolisd.log"
    error_log_path var/"log/botropolisd.log"
  end

  test do
    assert_equal "botropolis #{version}", shell_output("#{bin}/botropolis --version").strip
  end
end
