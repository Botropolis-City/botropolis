packaging/botropolis.svg
LIST
)
while read -r img; do
    [ -n "${img}" ] || continue
    case "${img}" in pkg/assets/*) continue;; esac   # Kenney art and the atlases, CC0
    if ! printf '%s\n' "${reviewed}" | grep -qxF "${img}"; then
        note "${img} is not on the reviewed list — look at it, then add it"
    fi
done < <(git ls-files | grep -iE '\.(png|jpe?g|gif|webp|svg|mp4|webm)$')

if [ "${fail}" -ne 0 ]; then
    printf '\n%s\n' "Not publishable yet."
    exit 1
fi
if [ "${refs}" = "checked" ]; then
    refs_said="every remote ref is in the history being published"
else
    refs_said="remote refs NOT checked: github could not be reached"
fi
if [ "${tokens_checked}" -eq 1 ]; then
    printf '  %s\n' "no employer tokens in history, ${refs_said}, every image reviewed."
else
    printf '  %s\n' "${refs_said}, every image reviewed. Employer tokens NOT checked: no .publishable-tokens on this machine."
fi
