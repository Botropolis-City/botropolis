#!/usr/bin/env bash
# Assert that every place naming a version agrees with the VERSION file.
#
# A version lives in one file so it can be changed in one place, but nothing
# enforces that the other places followed. On the two repositories this pattern
# was taken from, the one with a guard stayed in step and the one without had a
# PKGBUILD twelve patch versions behind its source. The guard is the difference.
set -euo pipefail

usage() {
    cat <<'USAGE'
check-version — assert everything that names a version agrees with VERSION

Usage: tools/check-version [--help]

Checks:
  1. VERSION holds a single semver line
  2. the newest released heading in CHANGELOG.md is that version
  3. the built binaries report it, if bin/ has been built
  4. nothing in testing/acceptance/testdata/surface at the last v* tag is
     gone without a Removed changelog entry naming it, and, from 1.0.0 on,
     a higher major version (item 149)

Exit 0 if they agree, 1 otherwise, naming each file that disagrees.
USAGE
}

[ "${1:-}" = "--help" ] && { usage; exit 0; }

cd "$(dirname "$0")/.." >/dev/null

fail=0
note() {
    printf '  %s\n' "$1"
    fail=1
}

if [ ! -f VERSION ]; then
    echo "  VERSION: missing"
    exit 1
fi

version="$(tr -d '[:space:]' < VERSION)"
if ! grep -qE '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$' <<< "${version}"; then
    note "VERSION: ${version} is not a semver"
fi

# The newest heading that is not [Unreleased]. Keep a Changelog puts the latest
# release first, so the first match is the one this tree claims to be.
# No match is grep exit 1, which under set -e would end the script before
# it could say so (item 135).
changelog="$(grep -m1 -oE '^## \[[0-9]+\.[0-9]+\.[0-9]+[^]]*\]' CHANGELOG.md | tr -d '#[] ')" || true
if [ -z "${changelog}" ]; then
    note "CHANGELOG.md: no released version heading found"
elif [ "${changelog}" != "${version}" ]; then
    note "CHANGELOG.md: newest release is ${changelog}, VERSION says ${version}"
fi

for bin in botropolis botropolisd botropolis-hook; do
    [ -x "bin/${bin}" ] || continue
    reported="$("bin/${bin}" --version 2>/dev/null | awk '{print $NF}')"
    if [ "${reported}" != "${version}" ]; then
        note "bin/${bin}: reports ${reported}, VERSION says ${version}"
    fi
done

# What 1.0.0 promises is in the surface files (item 149). Anything in them at
# the last release and gone now is a removal: it needs an entry naming it in
# backticks under a Removed heading written since that release, and from 1.0.0
# on a higher major version. The baseline is the release tag, which no change
# to the working tree can move.
surface_dir="testing/acceptance/testdata/surface"
surface_said=""
if ! git rev-parse --git-dir >/dev/null 2>&1; then
    surface_said="surface: not a git checkout, removals unchecked"
elif ! tag="$(git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null)"; then
    note "surface: no v* release tag is reachable from HEAD, so removals cannot be checked; fetch the tags (git fetch --tags)"
else
    baseline_files="$(git ls-tree -r --name-only "${tag}" -- "${surface_dir}")"
    if [ -z "${baseline_files}" ]; then
        surface_said="surface: no baseline at ${tag}, removals unchecked"
    else
        base_version="${tag#v}"
        removed_entries="$(awk -v base="${base_version}" '
            index($0, "## [" base "]") == 1 { exit }
            /^## \[/ { section = ""; next }
            /^### / { section = $0; next }
            section == "### Removed" { print }
        ' CHANGELOG.md)"
        base_major="${base_version%%.*}"
        major="${version%%.*}"
        removals=0
        while IFS= read -r file; do
            current=""
            [ -f "${file}" ] && current="$(cat "${file}")"
            while IFS= read -r line; do
                [ -n "${line}" ] || continue
                removals=$((removals + 1))
                name="${line%%$'\t'*}"
                if ! grep -qF "\`${name}\`" <<< "${removed_entries}"; then
                    note "${name}: removed since ${tag} with no \`${name}\` under Removed in CHANGELOG.md"
                fi
                if [ "${major}" -ge 1 ] && [ "${major}" -le "${base_major}" ]; then
                    note "${name}: removed since ${tag}, which needs $((base_major + 1)).0.0, and VERSION is ${version}"
                fi
            done < <(LC_ALL=C comm -23 <(git show "${tag}:${file}" | LC_ALL=C sort) <(printf '%s\n' "${current}" | LC_ALL=C sort))
        done <<< "${baseline_files}"
        surface_said="surface: ${removals} removed since ${tag}"
    fi
fi
[ -n "${surface_said}" ] && printf '  %s\n' "${surface_said}"

if [ "${fail}" -ne 0 ]; then
    printf '\n%s\n' "Version drift. Update the files above, or VERSION, so they agree."
    exit 1
fi

printf '  %s\n' "${version} everywhere: VERSION, CHANGELOG.md, and the built binaries."
