#!/usr/bin/env bash
# Verify the documentation structure holds: links resolve, citations are not
# stale, the indexes are not empty, and nothing is orphaned. The roadmap and its
# checks moved to the Botropolis-City meta repository at r410.
set -euo pipefail

usage() {
    cat <<'USAGE'
check-docs — verify the documentation structure holds

Usage: tools/check-docs [--help]

Checks, all against the working tree:
  1. every relative markdown link resolves from its own file's directory
  2. no "§N" citation to the pre-r310 ROADMAP survives
  3. DESIGN.md, CLAUDE.md and README.md are not empty; design/ and rules/ hold documents
  4. nothing in design/ or rules/ is linked from nowhere

The roadmap's checks (status lines, the open table, numbering) run in the
Botropolis-City meta repository, with the roadmap.

Exit 0 if all four hold, 1 otherwise, naming every failure.
USAGE
}

[ "${1:-}" = "--help" ] && { usage; exit 0; }
cd "$(dirname "$0")/.." >/dev/null
exec python3 tools/check_docs.py
