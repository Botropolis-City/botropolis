#!/usr/bin/env python3
"""Assert every image under pkg/assets has a traceable source.

Usage: tools/check-asset-sources [--root DIR] [--help]

The rule is in design/art-sources.md (item 123): every picture comes
from a human artist, an openly licensed pack, or geometry built by hand
in code. This checks the part of that a file can show. Every image under
pkg/assets/, found on the filesystem so an untracked one counts too,
must be one of:

  1. licensed: its own directory holds a non-empty licence file
     (License*, Licence*, COPYING*, any case);
  2. rendered: it is in pkg/assets/kits/, where make sprites writes, and
     the "pages" list of a kits-z*.json manifest there names it, so
     tools/render-sprites produces it and make sprites-check reproduces it.

An image is a file with an image extension or an image's leading bytes,
so renaming one does not hide it. pkg/assets missing, or holding no
images at all, fails too: every check above passes on nothing.

It cannot tell whether a picture came from an image model. Nothing can;
the written rule is the guard for that.

Exit 0 if every image is accounted for, 1 otherwise, naming each file.
"""

import json
import os
import re
import sys

ASSETS = os.path.join("pkg", "assets")
RENDERED = os.path.join(ASSETS, "kits")
MANIFEST = re.compile(r"^kits-z\d+(\.\d+)?\.json$")
LICENCE = re.compile(r"^(licen[cs]e|copying)([._-].*)?$", re.IGNORECASE)
EXTENSIONS = {
    ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".tga", ".tif", ".tiff",
    ".ico", ".avif", ".svg", ".exr", ".hdr", ".dds", ".ktx", ".ktx2", ".psd", ".qoi",
}
SIGNATURES = (
    b"\x89PNG\r\n\x1a\n",
    b"\xff\xd8\xff",
    b"GIF87a",
    b"GIF89a",
    b"BM",
    b"II*\x00",
    b"MM\x00*",
    b"8BPS",
    b"qoif",
)


def is_image(path):
    if os.path.splitext(path)[1].lower() in EXTENSIONS:
        return True
    with open(path, "rb") as f:
        head = f.read(16)
    if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
        return True
    return head.startswith(SIGNATURES)


def licensed(directory):
    for name in os.listdir(directory):
        path = os.path.join(directory, name)
        if LICENCE.match(name) and os.path.isfile(path) and os.path.getsize(path) > 0:
            return True
    return False


def rendered_pages(kits):
    pages = set()
    if not os.path.isdir(kits):
        return pages
    for name in os.listdir(kits):
        if MANIFEST.match(name):
            with open(os.path.join(kits, name)) as f:
                listed = json.load(f).get("pages", [])
            pages.update(os.path.join(kits, p) for p in listed)
    return pages


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    root = argv[argv.index("--root") + 1] if "--root" in argv else os.path.join(os.path.dirname(__file__), "..")
    assets = os.path.join(root, ASSETS)
    if not os.path.isdir(assets):
        print(f"check-asset-sources: {ASSETS} does not exist under {root}", file=sys.stderr)
        return 1

    pages = rendered_pages(os.path.join(root, RENDERED))
    counts = {"licensed": 0, "rendered": 0}
    failures = []
    for directory, dirs, files in os.walk(assets):
        dirs.sort()
        for name in sorted(files):
            path = os.path.join(directory, name)
            if not is_image(path):
                continue
            rel = os.path.relpath(path, root)
            if path in pages:
                counts["rendered"] += 1
            elif licensed(directory):
                counts["licensed"] += 1
            else:
                failures.append(
                    f"{rel}: no licence file beside it, and no kits-z*.json manifest in {RENDERED} names it as a page"
                )

    if failures:
        for line in failures:
            print(f"check-asset-sources: {line}", file=sys.stderr)
        print(
            "check-asset-sources: every image needs a source: see design/art-sources.md",
            file=sys.stderr,
        )
        return 1
    if counts["licensed"] + counts["rendered"] == 0:
        print(f"check-asset-sources: no images under {ASSETS}: every check passes on nothing", file=sys.stderr)
        return 1
    print(
        f"check-asset-sources: {counts['licensed']} licensed, "
        f"{counts['rendered']} rendered pages, none unaccounted for"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
