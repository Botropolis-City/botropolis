#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<USAGE
Usage: $(basename "$0") [--new] VERSION OUT
       $(basename "$0") --help

Builds the Homebrew tap served at pkg.botropolis.city/brew: a bare git
repository holding Formula/botropolis.rb for VERSION, readable over git's
static ("dumb") HTTP protocol, which is all a bucket can serve.

  brew tap botropolis-city/botropolis https://pkg.botropolis.city/brew
  brew install botropolis-city/botropolis/botropolis

The formula builds from the source archive GitHub serves for vVERSION, so
nothing downloaded is an unsigned binary, and its sha256 is taken from that
archive here.

The tap's history is continued from the published one, because brew update
fetches into the clone it already has and a rewritten history is not a fast
forward. If the published tap cannot be cloned this refuses, rather than
quietly starting a new history; --new starts one deliberately, which is
right exactly once.

Environment:
  PKG_BASE_URL   where the tap is published (default: https://pkg.botropolis.city)
  SOURCE_URL     the source archive (default: GitHub's for vVERSION)
USAGE
}

new=0
case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  --new) new=1; shift ;;
esac
[[ $# -eq 2 ]] || { usage >&2; exit 2; }

version=$1
out=$2
base=${PKG_BASE_URL:-https://pkg.botropolis.city}
source_url=${SOURCE_URL:-https://github.com/Botropolis-City/botropolis/archive/refs/tags/v${version}.tar.gz}
template=$(dirname "$0")/../packaging/brew/botropolis.rb.in

sha=$(curl -fsSL "$source_url" | sha256sum | cut -d' ' -f1)
[[ $sha =~ ^[0-9a-f]{64}$ ]] || { echo "could not hash $source_url" >&2; exit 1; }

rm -rf "$out"
mkdir -p "$(dirname "$out")"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

export GIT_AUTHOR_NAME="Botropolis Packages" GIT_AUTHOR_EMAIL="packages@botropolis.city"
export GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
git_() { git -c commit.gpgsign=false -c init.defaultBranch=main "$@"; }

if ((new)); then
  git_ init -q "$work/tap"
elif ! git_ clone -q "$base/brew" "$work/tap" 2>"$work/clone.err"; then
  echo "could not clone the published tap at $base/brew; pass --new to start a new history" >&2
  sed 's/^/  /' "$work/clone.err" >&2
  exit 1
fi

mkdir -p "$work/tap/Formula"
sed -e "s/@VERSION@/${version}/g" -e "s/@SHA256@/${sha}/g" "$template" >"$work/tap/Formula/botropolis.rb"
git_ -C "$work/tap" add Formula/botropolis.rb
if git_ -C "$work/tap" diff --cached --quiet; then
  echo "the tap already has botropolis ${version}" >&2
else
  git_ -C "$work/tap" commit -q -m "botropolis ${version}"
fi

git_ clone -q --bare "$work/tap" "$out"
git -C "$out" remote remove origin 2>/dev/null || true
git -C "$out" gc -q --aggressive --prune=now
git -C "$out" update-server-info
echo "built the tap for botropolis ${version} into $out ($(git -C "$out" rev-parse --short HEAD))" >&2
