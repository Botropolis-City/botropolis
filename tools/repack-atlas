#!/usr/bin/env python3
"""Re-lay the kit atlases' pages with tools/render-sprites/pack.py,
without rendering anything again.

Each sprite is cut from the page it is on now and laid on new pages where
pack.py puts it; its pixels, anchor and every other manifest field stay
as they are, and only its page, x and y move. A last page is only as tall
as its lowest sprite needs. Pages no longer named are removed, and the
pages written go through tools/shrink-pngs. `make sprites-check` then
compares every sprite's pixels with the committed ones (tools/atlas-diff.py).

Usage: tools/repack-atlas [--folder pkg/assets/kits]
"""

import argparse
import glob
import importlib.util
import json
import os
import subprocess
import sys

import numpy as np
from PIL import Image

HERE = os.path.dirname(os.path.abspath(__file__))
spec = importlib.util.spec_from_file_location("pack", os.path.join(HERE, "render-sprites", "pack.py"))
pack = importlib.util.module_from_spec(spec)
spec.loader.exec_module(pack)


def repack(folder, path):
    with open(path) as f:
        manifest = json.load(f)
    stem = os.path.basename(path)[: -len(".json")]
    old = [np.asarray(Image.open(os.path.join(folder, name)).convert("RGBA")) for name in manifest["pages"]]
    keys = sorted((name, heading) for name, headings in manifest["sprites"].items() for heading in headings)
    entries = [manifest["sprites"][n][h] for n, h in keys]
    sizes = [(e["w"], e["h"]) for e in entries]
    placed, heights = pack.pack(sizes, page=manifest["page"])
    pages = [np.zeros((h, manifest["page"], 4), dtype=np.uint8) for h in heights]
    for i, e in enumerate(entries):
        cut = old[e["page"]][e["y"] : e["y"] + e["h"], e["x"] : e["x"] + e["w"]]
        p, x, y = placed[i]
        pages[p][y : y + e["h"], x : x + e["w"]] = cut
        e["page"], e["x"], e["y"] = p, x, y
    names = []
    for i, page in enumerate(pages):
        name = f"{stem}-{i}.png"
        Image.fromarray(page, "RGBA").save(os.path.join(folder, name))
        names.append(name)
    for stale in sorted(glob.glob(os.path.join(folder, f"{stem}-*.png"))):
        if os.path.basename(stale) not in names:
            os.remove(stale)
    manifest["pages"] = names
    with open(path, "w") as f:
        json.dump(manifest, f, indent=1, sort_keys=True)
        f.write("\n")
    subprocess.run([os.path.join(HERE, "shrink-pngs"), *[os.path.join(folder, n) for n in names]], check=True)
    before = pack.cost([o.shape[0] for o in old], manifest["page"]) >> 20
    after = pack.cost(heights, manifest["page"]) >> 20
    print(f"REPACKED {stem}: {len(entries)} sprites, {len(old)} pages ({before} MiB) to {len(names)} ({after} MiB)")


def main():
    p = argparse.ArgumentParser(prog="tools/repack-atlas", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--folder", default="pkg/assets/kits", help="the folder holding the atlases (default: pkg/assets/kits)")
    args = p.parse_args()
    for path in sorted(glob.glob(os.path.join(args.folder, "kits-z*.json"))):
        repack(args.folder, path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
